{
  "name": "sop_evaluation",
  "strict": true,
  "schema": {
    "type": "object",
    "properties": {
      "evaluation": {
        "type": "object",
        "properties": {
          "passion": {
            "type": "object",
            "properties": {
              "motivation_for_scientific_research": {
                "type": "object",
                "properties": {
                  "score": {
                    "type": "integer",
                    "description": "Score for the motivation for scientific research category."
                  },
                  "rationale": {
                    "type": "string",
                    "description": "Justification for the score supported by citations from the SoP."
                  }
                },
                "required": [
                  "score",
                  "rationale"
                ],
                "additionalProperties": false
              },
              "initiative": {
                "type": "object",
                "properties": {
                  "score": {
                    "type": "integer",
                    "description": "Score for the initiative category."
                  },
                  "rationale": {
                    "type": "string",
                    "description": "Justification for the score supported by citations from the SoP."
                  }
                },
                "required": [
                  "score",
                  "rationale"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "motivation_for_scientific_research",
              "initiative"
            ],
            "additionalProperties": false
          },
          "clarity_of_purpose": {
            "type": "object",
            "properties": {
              "program_expectations_and_benefits": {
                "type": "object",
                "properties": {
                  "score": {
                    "type": "integer",
                    "description": "Score for the program expectations and benefits category."
                  },
                  "rationale": {
                    "type": "string",
                    "description": "Justification for the score supported by citations from the SoP."
                  }
                },
                "required": [
                  "score",
                  "rationale"
                ],
                "additionalProperties": false
              },
              "alignment_with_future_endeavors_and_career_direction": {
                "type": "object",
                "properties": {
                  "score": {
                    "type": "integer",
                    "description": "Score for the alignment with future endeavors and career direction category."
                  },
                  "rationale": {
                    "type": "string",
                    "description": "Justification for the score supported by citations from the SoP."
                  }
                },
                "required": [
                  "score",
                  "rationale"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "program_expectations_and_benefits",
              "alignment_with_future_endeavors_and_career_direction"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "passion",
          "clarity_of_purpose"
        ],
        "additionalProperties": false
      },
      "stars_track_choice": {
        "type": "object",
        "properties": {
          "track": {
            "type": "string",
            "description": "The track the student chose for the STARS program. Design or Manufacturing."
          },
          "rationale": {
            "type": "string",
            "description": "Recommendation for the STARS program track based on their SoP and interest, along with the rationale for the choice."
          }
        },
        "required": [
          "track",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "evaluation",
      "stars_track_choice"
    ],
    "additionalProperties": false
  }
}